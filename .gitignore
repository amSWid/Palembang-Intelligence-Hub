# Ignore everything
*

# Keep Git configuration files
!.gitignore

# Keep selected root files
!README.md
!app.py
!config.py
!requirements.txt
!audit_project.py
!final_rag_audit_report.txt

# Allow the core folder, then selected files only
!core/
core/*
!core/knowledge_catalog.py
!core/agent_selector.py

# Allow the pages folder, then home.py only
!pages/
pages/*
!pages/home.py